# Copy to .env and fill in. Never commit .env.

# --- Free LLM providers ---
# Groq (Llama 3.x):  https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini:     https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional paid providers (leave empty to keep the project free) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LLM_PROVIDER_ORDER=groq,gemini,anthropic,openai

# Local, free embeddings + re-ranker (downloaded once, run on CPU)
EMBEDDING_BACKEND=fastembed
RERANKER_BACKEND=fastembed

# Auth - change these!
JWT_SECRET=replace-with-a-long-random-string-of-32+-chars
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123

# Optional Redis cache
# REDIS_URL=redis://localhost:6379/0